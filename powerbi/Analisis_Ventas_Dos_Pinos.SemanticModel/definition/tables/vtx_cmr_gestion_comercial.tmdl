				    Catalogo = Source{[Name="prd_gold",Kind="Database"]}[Data],
				    Esquema = Catalogo{[Name="bix_cmr_ab_nacional",Kind="Schema"]}[Data],
				    Tabla = Esquema{[Name="vtx_cmr_gestion_comercial",Kind="Table"]}[Data],
				    Columnas = Table.SelectColumns(Tabla, {"FECHA_CONTAB", "DIA_MES", "LABOR_MES_ACT", "D_LABOR", "GERENCIA_BASE", "CLIGRP3_DESC", "FORMATO_DESC", "CADENA_DESC", "PROV_DESC", "EJECUTIVO_DESC", "CLIENTE_NOMBRE3", "CLIENTE_ID", "CATEG", "SUBCATEG", "MARCA", "MAT_DESC", "MAT_ID", "NEGOCIO", "VTA_COL", "VTAB_COL", "DESC_COL", "DEV_COL", "VTA_FCST_COL", "VTA_PLAN_COL", "VTA_PROYECTADA_COL", "KL"}),
				    Tipos = Table.TransformColumnTypes(Columnas, {{"FECHA_CONTAB", type date}, {"DIA_MES", Int64.Type}, {"LABOR_MES_ACT", type number}, {"D_LABOR", type number}, {"GERENCIA_BASE", type text}, {"CLIGRP3_DESC", type text}, {"FORMATO_DESC", type text}, {"CADENA_DESC", type text}, {"PROV_DESC", type text}, {"EJECUTIVO_DESC", type text}, {"CLIENTE_NOMBRE3", type text}, {"CLIENTE_ID", type text}, {"CATEG", type text}, {"SUBCATEG", type text}, {"MARCA", type text}, {"MAT_DESC", type text}, {"MAT_ID", type text}, {"NEGOCIO", type text}, {"VTA_COL", type number}, {"VTAB_COL", type number}, {"DESC_COL", type number}, {"DEV_COL", type number}, {"VTA_FCST_COL", type number}, {"VTA_PLAN_COL", type number}, {"VTA_PROYECTADA_COL", type number}, {"KL", type number}})
