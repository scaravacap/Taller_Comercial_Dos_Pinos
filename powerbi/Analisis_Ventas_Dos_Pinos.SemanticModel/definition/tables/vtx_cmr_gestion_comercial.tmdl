table vtx_cmr_gestion_comercial
	lineageTag: 3a272cef-1b0a-4513-afbd-e87cf40ea908

	/// Venta neta en millones de colones (venta_neta_col en la metric view).
	measure 'Venta Neta M' = DIVIDE(SUM(vtx_cmr_gestion_comercial[VTA_COL]), 1000000)
		formatString: #,0.0
		displayFolder: 1. Ventas (M₡)
		lineageTag: 61fffbbc-fc65-4cea-a989-0a2c043f739b

	/// Plan del mes completo, cargado el día 1 (venta_plan_col).
	measure 'Plan Mes M' = DIVIDE(SUM(vtx_cmr_gestion_comercial[VTA_PLAN_COL]), 1000000)
		formatString: #,0.0
		displayFolder: 1. Ventas (M₡)
		lineageTag: f21cca95-b660-40d0-a3e5-e783edadd8f2

	/// Forecast comercial del mes completo, cargado el día 1 (venta_fcst_col).
	measure 'FCST Mes M' = DIVIDE(SUM(vtx_cmr_gestion_comercial[VTA_FCST_COL]), 1000000)
		formatString: #,0.0
		displayFolder: 1. Ventas (M₡)
		lineageTag: 975055b1-15fb-4b23-a3eb-98b09241ca51

	/// Venta que falta para cumplir el plan del mes.
	measure 'Falta para Plan M' = [Plan Mes M] - [Venta Neta M]
		formatString: #,0.0
		displayFolder: 1. Ventas (M₡)
		lineageTag: 8eb443e0-ee66-4099-ae00-8ef194863c3d

	/// Proyección de cierre de Dos Pinos: venta real / días laborados × días laborables (venta_proyectada_col).
	measure 'Proyeccion Cierre M' = DIVIDE(SUM(vtx_cmr_gestion_comercial[VTA_PROYECTADA_COL]), 1000000)
		formatString: #,0.0
		displayFolder: 1. Ventas (M₡)
		lineageTag: 82ad557b-b8ed-43ab-a957-396e8762d505

	/// Venta neta / plan del mes (cumplimiento_plan_col).
	measure '% Cumplimiento Plan' = DIVIDE(SUM(vtx_cmr_gestion_comercial[VTA_COL]), SUM(vtx_cmr_gestion_comercial[VTA_PLAN_COL]))
		formatString: 0.0%
		displayFolder: 2. Cumplimiento
		lineageTag: 2d281698-6ef9-43a6-ae51-54dd9e92af3c

	/// Venta neta / forecast del mes (cumplimiento_fcst_col).
	measure '% Cumplimiento FCST' = DIVIDE(SUM(vtx_cmr_gestion_comercial[VTA_COL]), SUM(vtx_cmr_gestion_comercial[VTA_FCST_COL]))
		formatString: 0.0%
		displayFolder: 2. Cumplimiento
		lineageTag: 512f770b-f980-465d-a2d0-a8ea34e9b7de

	/// Días laborados / días laborables del mes: lo que debería llevarse vendido hoy.
	measure '% Avance Esperado' = DIVIDE(MAX(vtx_cmr_gestion_comercial[D_LABOR]), MAX(vtx_cmr_gestion_comercial[LABOR_MES_ACT]))
		formatString: 0.0%
		displayFolder: 2. Cumplimiento
		lineageTag: 700c5a40-1f21-41bf-a6d4-1242a6dbfd9b

	/// Puntos de cumplimiento por encima (+) o por debajo (-) del avance esperado.
	measure 'Brecha vs Avance pts' = ([% Cumplimiento Plan] - [% Avance Esperado]) * 100
		formatString: +0.0;-0.0;0.0
		displayFolder: 2. Cumplimiento
		lineageTag: 224e7b86-f37a-4027-aad1-aaeb2d1cc078

	/// Proyección de cierre / plan del mes.
	measure '% Proyeccion vs Plan' = DIVIDE(SUM(vtx_cmr_gestion_comercial[VTA_PROYECTADA_COL]), SUM(vtx_cmr_gestion_comercial[VTA_PLAN_COL]))
		formatString: 0.0%
		displayFolder: 2. Cumplimiento
		lineageTag: 2c3d155d-fb44-4f57-a6d6-1b7641841a7a

	/// Venta neta acumulada hasta el día del mes.
	measure 'Venta Acumulada M' = CALCULATE([Venta Neta M], FILTER(ALL(vtx_cmr_gestion_comercial[DIA_MES]), vtx_cmr_gestion_comercial[DIA_MES] <= MAX(vtx_cmr_gestion_comercial[DIA_MES])))
		formatString: #,0.0
		displayFolder: 3. Avance diario
		lineageTag: faf18c7e-3940-4f0b-ac16-b9ae0339dbac

	/// Plan del mes prorrateado por los días laborados hasta el día del mes.
	measure 'Plan Prorrateado Acumulado M' = CALCULATE([Plan Mes M], ALL(vtx_cmr_gestion_comercial[DIA_MES])) * DIVIDE(CALCULATE(DISTINCTCOUNT(vtx_cmr_gestion_comercial[DIA_MES]), FILTER(ALL(vtx_cmr_gestion_comercial[DIA_MES]), vtx_cmr_gestion_comercial[DIA_MES] <= MAX(vtx_cmr_gestion_comercial[DIA_MES]))), MAX(vtx_cmr_gestion_comercial[LABOR_MES_ACT]))
		formatString: #,0.0
		displayFolder: 3. Avance diario
		lineageTag: d7a0fa4a-1383-44aa-a716-45b87bc236f8

	/// Descuento sobre venta bruta.
	measure '% Descuento' = DIVIDE(SUM(vtx_cmr_gestion_comercial[DESC_COL]), SUM(vtx_cmr_gestion_comercial[VTAB_COL]))
		formatString: 0.0%
		displayFolder: 4. Calidad comercial
		lineageTag: f22f812f-3397-47d2-a4c4-23fc0c23ea72

	/// Devolución sobre venta bruta (DEV_COL viene en negativo).
	measure '% Devolucion' = DIVIDE(-SUM(vtx_cmr_gestion_comercial[DEV_COL]), SUM(vtx_cmr_gestion_comercial[VTAB_COL]))
		formatString: 0.00%
		displayFolder: 4. Calidad comercial
		lineageTag: 7d9e6352-87fc-4eb0-a0bb-b345db1b38b2

	/// Clientes con movimiento (clientes_activos).
	measure 'Clientes Activos' = DISTINCTCOUNT(vtx_cmr_gestion_comercial[CLIENTE_ID])
		formatString: #,0
		displayFolder: 4. Calidad comercial
		lineageTag: 14f33343-1fe5-4993-a560-a1855d4c2a98

	/// Materiales distintos con movimiento (skus_vendidos).
	measure 'SKUs Vendidos' = DISTINCTCOUNT(vtx_cmr_gestion_comercial[MAT_ID])
		formatString: #,0
		displayFolder: 4. Calidad comercial
		lineageTag: c70e370b-1692-4098-aa2b-5df496c509a1

	/// Volumen en kilolitros (kilolitros).
	measure 'Volumen KL' = SUM(vtx_cmr_gestion_comercial[KL])
		formatString: #,0.0
		displayFolder: 4. Calidad comercial
		lineageTag: d6fac822-2e20-4c6b-a58d-ce8b95d2662f

	/// Días laborados del mes.
	measure 'Dias Laborados' = MAX(vtx_cmr_gestion_comercial[D_LABOR])
		formatString: 0
		displayFolder: 5. Calendario
		lineageTag: afc73c02-c7f8-4269-afa3-72d7184876b4

	/// Días laborables del mes.
	measure 'Dias Laborables' = MAX(vtx_cmr_gestion_comercial[LABOR_MES_ACT])
		formatString: 0
		displayFolder: 5. Calendario
		lineageTag: 6d472046-0368-4152-ab19-bc0e6e8766dc

