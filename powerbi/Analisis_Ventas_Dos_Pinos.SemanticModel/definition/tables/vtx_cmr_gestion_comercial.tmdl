table vtx_cmr_gestion_comercial
	lineageTag: 3a272cef-1b0a-4513-afbd-e87cf40ea908

	/// Venta neta en millones de colones.
	measure 'Venta Real M' = DIVIDE(SUM(vtx_cmr_gestion_comercial[VTA_COL]), 1000000)
		formatString: #,0.0
		displayFolder: 1. Ventas (M₡)
		lineageTag: eafd8020-e9fb-45ee-acb7-d38199a42e4c

	/// Venta bruta en millones de colones.
	measure 'Venta Bruta M' = DIVIDE(SUM(vtx_cmr_gestion_comercial[VTAB_COL]), 1000000)
		formatString: #,0.0
		displayFolder: 1. Ventas (M₡)
		lineageTag: 39015ff6-33c5-4618-a334-8a153c96181b

	/// Plan del mes completo (se carga el día 1).
	measure 'Plan Mes M' = DIVIDE(SUM(vtx_cmr_gestion_comercial[VTA_PLAN_COL]), 1000000)
		formatString: #,0.0
		displayFolder: 1. Ventas (M₡)
		lineageTag: f21cca95-b660-40d0-a3e5-e783edadd8f2

	/// Forecast del mes completo (se carga el día 1).
	measure 'FCST Mes M' = DIVIDE(SUM(vtx_cmr_gestion_comercial[VTA_FCST_COL]), 1000000)
		formatString: #,0.0
		displayFolder: 1. Ventas (M₡)
		lineageTag: 975055b1-15fb-4b23-a3eb-98b09241ca51

	/// Plan ponderado a los días laborados (plan mes × laborados / laborables).
	measure 'Plan Pond M' = DIVIDE(SUM(vtx_cmr_gestion_comercial[VTA_PLAN_POND_COL]), 1000000)
		formatString: #,0.0
		displayFolder: 1. Ventas (M₡)
		lineageTag: 3dd0e931-bef7-4882-a783-1a326ddb1dde

	/// Forecast ponderado a los días laborados.
	measure 'FCST Pond M' = DIVIDE(SUM(vtx_cmr_gestion_comercial[VTA_FCST_POND_COL]), 1000000)
		formatString: #,0.0
		displayFolder: 1. Ventas (M₡)
		lineageTag: 0f914a8b-70b6-432e-aea9-747c9ea64e04

	/// Proyección de cierre: venta real / laborados × laborables.
	measure 'Venta Proyectada M' = DIVIDE(SUM(vtx_cmr_gestion_comercial[VTA_PROYECTADA_COL]), 1000000)
		formatString: #,0.0
		displayFolder: 1. Ventas (M₡)
		lineageTag: 1d6e032b-3bf6-4f57-abab-df34d7013f08

	/// Δ₡ contra el plan ponderado.
	measure 'Dif vs Plan M' = [Venta Real M] - [Plan Pond M]
		formatString: #,0.0
		displayFolder: 1. Ventas (M₡)
		lineageTag: ae4578f1-db41-4b36-a547-fbd0a302aaca

	/// Δ₡ contra el forecast ponderado.
	measure 'Dif vs FCST M' = [Venta Real M] - [FCST Pond M]
		formatString: #,0.0
		displayFolder: 1. Ventas (M₡)
		lineageTag: 7d03e658-27e1-4329-a589-a353b7a580b0

	/// Venta real / plan ponderado (como el reporte original).
	measure '% Cump Plan' = DIVIDE(SUM(vtx_cmr_gestion_comercial[VTA_COL]), SUM(vtx_cmr_gestion_comercial[VTA_PLAN_POND_COL]))
		formatString: 0.0%
		displayFolder: 2. Cumplimiento
		lineageTag: 0aedd14b-f179-4107-a337-af6b38a7ee2d

	/// Venta real / forecast ponderado.
	measure '% Cump FCST' = DIVIDE(SUM(vtx_cmr_gestion_comercial[VTA_COL]), SUM(vtx_cmr_gestion_comercial[VTA_FCST_POND_COL]))
		formatString: 0.0%
		displayFolder: 2. Cumplimiento
		lineageTag: 6a74c0b5-1a13-4d46-a799-303f12541608

	/// Venta real / plan del mes completo.
	measure '% Avance Plan Mes' = DIVIDE(SUM(vtx_cmr_gestion_comercial[VTA_COL]), SUM(vtx_cmr_gestion_comercial[VTA_PLAN_COL]))
		formatString: 0.0%
		displayFolder: 2. Cumplimiento
		lineageTag: 33c30194-4584-49d7-a69b-ee212885aa0a

	/// Venta real / forecast del mes completo.
	measure '% Avance FCST Mes' = DIVIDE(SUM(vtx_cmr_gestion_comercial[VTA_COL]), SUM(vtx_cmr_gestion_comercial[VTA_FCST_COL]))
		formatString: 0.0%
		displayFolder: 2. Cumplimiento
		lineageTag: eb56a768-ca5f-490c-ae88-fe6778157097

	/// Proyección de cierre / plan del mes.
	measure '% Proyeccion vs Plan' = DIVIDE(SUM(vtx_cmr_gestion_comercial[VTA_PROYECTADA_COL]), SUM(vtx_cmr_gestion_comercial[VTA_PLAN_COL]))
		formatString: 0.0%
		displayFolder: 2. Cumplimiento
		lineageTag: 2c3d155d-fb44-4f57-a6d6-1b7641841a7a

	/// Venta real acumulada hasta el día del mes.
	measure 'Venta Acumulada M' = CALCULATE([Venta Real M], FILTER(ALL(vtx_cmr_gestion_comercial[DIA_MES]), vtx_cmr_gestion_comercial[DIA_MES] <= MAX(vtx_cmr_gestion_comercial[DIA_MES])))
		formatString: #,0.0
		displayFolder: 3. Avance diario
		lineageTag: faf18c7e-3940-4f0b-ac16-b9ae0339dbac

	/// Plan del mes prorrateado por días con venta hasta el día del mes.
	measure 'Plan Pond Acumulado M' = CALCULATE([Plan Mes M], ALL(vtx_cmr_gestion_comercial[DIA_MES])) * DIVIDE(CALCULATE(DISTINCTCOUNT(vtx_cmr_gestion_comercial[DIA_MES]), FILTER(ALL(vtx_cmr_gestion_comercial[DIA_MES]), vtx_cmr_gestion_comercial[DIA_MES] <= MAX(vtx_cmr_gestion_comercial[DIA_MES]))), MAX(vtx_cmr_gestion_comercial[LABOR_MES_ACT]))
		formatString: #,0.0
		displayFolder: 3. Avance diario
		lineageTag: 1b84d5cc-654a-4ca8-aaa2-e8b3b54d12fa

	/// Descuento sobre venta bruta.
	measure '% Descuento' = DIVIDE(SUM(vtx_cmr_gestion_comercial[DESC_COL]), SUM(vtx_cmr_gestion_comercial[VTAB_COL]))
		formatString: 0.0%
		displayFolder: 4. Calidad comercial
		lineageTag: f22f812f-3397-47d2-a4c4-23fc0c23ea72

	/// Devolución sobre venta bruta (DEV_COL viene en negativo).
	measure '% Devolucion' = DIVIDE(-SUM(vtx_cmr_gestion_comercial[DEV_COL]), SUM(vtx_cmr_gestion_comercial[VTAB_COL]))
		formatString: 0.0%
		displayFolder: 4. Calidad comercial
		lineageTag: 7d9e6352-87fc-4eb0-a0bb-b345db1b38b2

	/// Clientes con movimiento.
	measure 'Clientes Activos' = DISTINCTCOUNT(vtx_cmr_gestion_comercial[CLIENTE_ID])
		formatString: #,0
		displayFolder: 4. Calidad comercial
		lineageTag: 14f33343-1fe5-4993-a560-a1855d4c2a98

	/// Materiales distintos con movimiento.
	measure 'SKUs' = DISTINCTCOUNT(vtx_cmr_gestion_comercial[MAT_ID])
		formatString: #,0
		displayFolder: 4. Calidad comercial
		lineageTag: 1ebcef6f-a646-4bb6-a99e-e33b3aa6fb77

	/// Volumen en kilolitros.
	measure 'Volumen KL' = SUM(vtx_cmr_gestion_comercial[KL])
		formatString: #,0.0
		displayFolder: 4. Calidad comercial
		lineageTag: d6fac822-2e20-4c6b-a58d-ce8b95d2662f

	/// Venta real solo para los 10 materiales de mayor venta en el filtro actual.
	measure 'Venta Top 10 Material M' = IF(RANKX(ALLSELECTED(vtx_cmr_gestion_comercial[MAT_DESC]), [Venta Real M]) <= 10, [Venta Real M])
		formatString: #,0.0
		displayFolder: 4. Calidad comercial
		lineageTag: 9328dfe5-0ea5-40d4-ad48-f4f92f26b5c8

	/// Días laborados del mes.
	measure 'Dias Laborados' = MAX(vtx_cmr_gestion_comercial[D_LABOR])
		formatString: 0
		displayFolder: 5. Calendario
		lineageTag: afc73c02-c7f8-4269-afa3-72d7184876b4

	/// Días laborables del mes.
	measure 'Dias Laborables' = MAX(vtx_cmr_gestion_comercial[LABOR_MES_ACT])
		formatString: 0
		displayFolder: 5. Calendario
		lineageTag: 6d472046-0368-4152-ab19-bc0e6e8766dc

	/// Días laborables pendientes.
	measure 'Dias Pendientes' = MAX(vtx_cmr_gestion_comercial[D_PENDI])
		formatString: 0
		displayFolder: 5. Calendario
		lineageTag: c0bcf39b-d117-4e2a-a55d-a288ed92712d

